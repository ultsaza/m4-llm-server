@@ -0,0 +1,121 @@
+"""Encrypted, stateless continuation notes for the Codex v2 protocol."""
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+
+
+class CompactionCodec:
+    MAX_TOKEN_BYTES = 128 * 1024
+    MAX_NOTE_BYTES = 64 * 1024
+
+    def __init__(self, secret: str, model: str):
+        from cryptography.fernet import Fernet
+        from cryptography.hazmat.primitives import hashes
+        from cryptography.hazmat.primitives.kdf.hkdf import HKDF
+
+        key = HKDF(algorithm=hashes.SHA256(), length=32, salt=None,
+                   info=b"macqwen-continuation-v1").derive(secret.encode())
+        self.fernet = Fernet(base64.urlsafe_b64encode(key))
+        self.model = model
+
+    def seal(self, summary: str, users: list[str]) -> str:
+        value = {"version": 1, "model": self.model, "summary": summary,
+                 "users": users, "covered": sorted({fingerprint(text) for text in users})}
+        self._validate(value)
+        wire = dict(value, covered=base64.b64encode(
+            b"".join(bytes.fromhex(item) for item in value["covered"])).decode())
+        raw = json.dumps(wire, ensure_ascii=False, separators=(",", ":")).encode()
+        if len(raw) > self.MAX_NOTE_BYTES:
+            raise ValueError("compaction note exceeds its size limit")
+        return self.fernet.encrypt(raw).decode("ascii")
+
+    def open(self, token: str) -> dict:
+        from cryptography.fernet import InvalidToken
+
+        if not isinstance(token, str) or len(token) > self.MAX_TOKEN_BYTES:
+            raise ValueError("invalid compaction packet")
+        try:
+            raw = self.fernet.decrypt(token.encode("ascii"))
+            if len(raw) > self.MAX_NOTE_BYTES:
+                raise ValueError("invalid compaction packet")
+            value = json.loads(raw)
+            if not isinstance(value, dict) or not isinstance(value.get("covered"), str):
+                raise ValueError("invalid compaction packet")
+            hashes_raw = base64.b64decode(value["covered"], validate=True)
+            if len(hashes_raw) % 32:
+                raise ValueError("invalid compaction packet")
+            value["covered"] = [hashes_raw[i:i+32].hex() for i in range(0, len(hashes_raw), 32)]
+            self._validate(value)
+        except (InvalidToken, ValueError, TypeError, UnicodeError, RecursionError):
+            raise ValueError("invalid compaction packet") from None
+        return value
+
+    def _validate(self, value):
+        if (not isinstance(value, dict)
+                or set(value) != {"version", "model", "summary", "covered", "users"}
+                or type(value["version"]) is not int or value["version"] != 1
+                or value["model"] != self.model
+                or not isinstance(value["summary"], str) or not value["summary"].strip()
+                or len(value["summary"].encode()) > 16 * 1024
+                or not isinstance(value["covered"], list) or len(value["covered"]) > 512
+                or any(not isinstance(item, str) or len(item) != 64
+                       or any(c not in "0123456789abcdef" for c in item)
+                       for item in value["covered"])
+                or not isinstance(value["users"], list)
+                or any(not isinstance(text, str) for text in value["users"])
+                or sum(len(text.encode()) for text in value["users"]) > 6000
+                or value["covered"] != sorted({fingerprint(text) for text in value["users"]})):
+            raise ValueError("invalid compaction packet")
+
+
+def fingerprint(text: str) -> str:
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def excerpt(text: str, limit: int) -> str:
+    encoded = text.encode()
+    if len(encoded) <= limit:
+        return text
+    half = limit // 2
+    return (encoded[:half].decode("utf-8", "ignore") + "\n[excerpt; middle omitted]\n"
+            + encoded[-half:].decode("utf-8", "ignore"))
+
+
+def continuation_note(messages, result, prior_note=None, new_users=()):
+    """Keep task/result literals even if the model's prose is degenerate."""
+    candidate = result.text.strip()
+    use_model = (len(candidate) >= 64 and result.stats.finish != "length"
+                 and not result.tool_calls and not result.protocol_error
+                 and not any(marker in candidate.lower() for marker in
+                             ("<tool", "<|tool", "<function", "<name>", "<arguments>")))
+    parts = ["Continuation notes. Use the recorded tool outcomes to distinguish completed work "
+             "from failed attempts. Do not repeat successful actions; continue the pending user task."]
+    if use_model:
+        parts.append(excerpt(candidate, 2400))
+    if prior_note:
+        parts.append("Previous state:\n" + excerpt(prior_note["summary"], 2400))
+    # Never mark a user request covered just because a model summarized it.
+    # Store complete literals in a bounded ledger. Anything that does not fit
+    # remains an ordinary user message on subsequent replay.
+    retained = list(prior_note["users"]) if prior_note else []
+    size = sum(len(text.encode()) for text in retained)
+    for text in new_users:
+        if text not in retained and size + len(text.encode()) <= 6000:
+            retained.append(text)
+            size += len(text.encode())
+    recent = [m for m in messages if m["role"] == "tool"][-2:]
+    if recent:
+        calls = {call["id"]: call["function"] for message in messages
+                 for call in message.get("tool_calls", [])}
+        records = []
+        for message in recent:
+            function = calls.get(message.get("tool_call_id"))
+            attempt = ("Recorded tool attempt (already returned):\n" +
+                       excerpt(json.dumps(function, ensure_ascii=False), 800) + "\n"
+                       if function else "")
+            records.append(attempt + "Observed result:\n" + excerpt(message["content"], 1200))
+        parts.append("Recent tool results (literal excerpts, including failures):\n" +
+                     "\n\n".join(records))
+    return "\n\n".join(parts), "model+extracts" if use_model else "extractive", retained
