+"""Pool sidecar geometry, byte placement, startup and failure transactions."""
+from __future__ import annotations
+
+from concurrent.futures import ThreadPoolExecutor
+import hashlib
+import json
+import os
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import tempfile
+import threading
+from types import SimpleNamespace
+import unittest
+from unittest import mock
+
+from models.flashnext import expert_cache, expert_pool, small_sidecar
+from models.flashnext.slab_pack import get_slab_layout
+from models.flashnext.store import SafeTensorStore
+
+PREFIX = "language_model.model.layers.4.mlp.switch_mlp"
+EXPERTS = 5
+SIDE_FLAG = "FLASHNEXT_EXPERT_POOL_SMALL_SIDECAR"
+
+
+class Fixture:
+    """Real, typed safetensors with hand-chosen, expert-distinct row bytes."""
+    def __init__(self, directory):
+        self.directory = Path(directory)
+        header, payload = {}, bytearray()
+        shapes = {"gate_proj": ((640, 320), (640, 80)),
+                  "up_proj": ((640, 320), (640, 80)),
+                  "down_proj": ((2560, 80), (2560, 20))}
+        self.expected = {}
+        for projection_index, (projection, tails) in enumerate(shapes.items()):
+            for part_index, part in enumerate(("weight", "scales", "biases")):
+                size = 819200 if part == "weight" else 102400
+                name = f"{PREFIX}.{projection}.{part}"
+                begin = len(payload)
+                for expert in range(EXPERTS):
+                    row = bytes([1 + 20 * expert + 3 * projection_index + part_index]) * size
+                    self.expected[name, expert] = row
+                    payload.extend(row)
+                header[name] = {"dtype": "U32" if part == "weight" else "BF16",
+                                "shape": [EXPERTS, *tails[part != "weight"]],
+                                "data_offsets": [begin, len(payload)]}
+        raw = json.dumps(header).encode()
+        shard = "model.safetensors"
+        (self.directory / shard).write_bytes(struct.pack("<Q", len(raw)) + raw + payload)
+        (self.directory / "model.safetensors.index.json").write_text(json.dumps({
+            "weight_map": {name: shard for name in header}}))
+        self.store = SafeTensorStore(str(self.directory))
+        self.out = self.directory / "sidecar"
+
+    def build(self):
+        return small_sidecar.build_pool(self.store, self.out)
+
+    def pool(self):
+        with mock.patch.dict(os.environ, {SIDE_FLAG: str(self.out)}):
+            return expert_pool.ExpertPool(self.store, 4096 + 16 * 3072000)
+
+    def manifest(self):
+        return json.loads((self.out / "manifest.json").read_text())
+
+    def replace_manifest(self, manifest):
+        path = self.out / "manifest.json"
+        path.chmod(0o600)
+        path.write_text(json.dumps(manifest))
+        path.chmod(0o444)
+
+
+class SidecarTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.fixture = Fixture(self.temp.name)
+        self.addCleanup(self.temp.cleanup)
+        self.addCleanup(self.fixture.store.close)
+
+    def test_scatter_matches_all_nine_fields_with_header_and_noncontiguous_slots(self):
