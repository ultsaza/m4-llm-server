+    def test_partial_submit_failure_drains_running_and_queued_reads(self):
+        started, release, queued_done = threading.Event(), threading.Event(), threading.Event()
+        def blocking(*_):
+            started.set()
+            if not release.wait(2):
+                raise AssertionError("test worker release timed out")
+        def queued(*_):
+            queued_done.set()
+        errors = []
+        with ThreadPoolExecutor(1) as workers:
+            count = [0]
+            def submit(fn, *args):
+                count[0] += 1
+                if count[0] == 3:
+                    raise RuntimeError("submit failed")
+                return workers.submit(blocking if count[0] == 1 else queued)
+            def fill():
+                try:
+                    self.pool.fill(PREFIX, [(0, 0)], submit)
+                except BaseException as error:
+                    errors.append(error)
+            thread = threading.Thread(target=fill)
+            thread.start()
+            self.assertTrue(started.wait(1))
+            thread.join(0.02)
+            still_draining = thread.is_alive()
+            release.set()
+            thread.join(2)
+        self.assertTrue(still_draining, "submit exception escaped before running read drained")
+        self.assertTrue(queued_done.is_set(), "queued task was not drained")
+        self.assertEqual(str(errors[0]), "submit failed")
