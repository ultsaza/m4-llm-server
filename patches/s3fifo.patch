+    def test_drain_terminates_for_completed_baseexception_and_cancelled_real_futures(self):
+        completed = threading.Event()
+        release, started = threading.Event(), threading.Event()
+        def failed():
+            raise KeyboardInterrupt("worker failed")
+        def blocking():
+            started.set()
+            if not release.wait(2):
+                raise AssertionError("test release timed out")
+        with ThreadPoolExecutor(1) as workers:
+            failed_future = workers.submit(failed)
+            failed_future.add_done_callback(lambda _: completed.set())
+            self.assertTrue(completed.wait(1))
+            with self.assertRaises(KeyboardInterrupt):
+                failed_future.result()
+            blocking_future = workers.submit(blocking)
+            try:
+                self.assertTrue(started.wait(1))
+                cancelled = workers.submit(lambda: None)
+                self.assertTrue(cancelled.cancel())
+                expert_pool.drain_futures([failed_future, cancelled])
+                self.assertTrue(failed_future.done())
+                self.assertTrue(cancelled.cancelled())
+            finally:
+                release.set()
+                blocking_future.result()
