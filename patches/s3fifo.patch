+"""Byte-exact S3-FIFO through the actual Metal-backed pool and reads."""
+from concurrent.futures import ThreadPoolExecutor
+import os
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest import mock
+from models.flashnext import expert_pool, expert_cache
+from models.flashnext.expert_pool_policy import POLICY_FLAG, FRACTION_FLAG
+from . import test_pool_small_sidecar as fixtures
+
+
+class S3FIFOTransactions(fixtures.TransactionTests):
+    def setUp(self):
+        with mock.patch.dict(os.environ, {POLICY_FLAG: 's3fifo'}):
+            super().setUp()
+        self.assertEqual(self.pool.cache_policy, 's3fifo')
+
+    def tearDown(self):
+        state = self.pool.policy_diagnostics()
+        self.assertEqual(state['small_count'] + state['main_count'], len(self.pool._slot_of))
+        self.assertLessEqual(state['ghost_count'], state['main_target'])
+        self.assertEqual(set(self.pool._slot_of.values()) | set(self.pool._free), set(range(16)))
+        self.assertFalse(set(self.pool._slot_of.values()) & set(self.pool._free))
+
+
+class S3FIFOPoolTests(unittest.TestCase):
+    def test_startup_validation_and_constructor_reject_before_allocation(self):
+        for gb in ('0', '6'):
+            with mock.patch.dict(os.environ, {POLICY_FLAG: 's3fifo', expert_pool.SIZE_FLAG: gb, fixtures.SIDE_FLAG: ''}):
+                os.environ.pop(FRACTION_FLAG, None)
+                store = SimpleNamespace()
+                if gb == '0':
+                    with self.assertRaises(ValueError):
+                        expert_pool.initialize_sidecar(store)
+                else:
+                    expert_pool.initialize_sidecar(store)
+                    self.assertEqual(store._flashnext_pool_cache_policy, 's3fifo')
+        with mock.patch.dict(os.environ, {POLICY_FLAG: 's3fifo', FRACTION_FLAG: '0.5',
+                expert_pool.SIZE_FLAG: '6', fixtures.SIDE_FLAG: ''}), \
+                mock.patch.object(expert_pool.mmap, 'mmap', side_effect=AssertionError('allocated')):
+            with self.assertRaises(ValueError):
+                expert_pool.initialize_sidecar(SimpleNamespace())
+            with self.assertRaises(ValueError):
+                expert_pool.ExpertPool(SimpleNamespace(dir='/absent', refs={}), 4096 + 16 * 3072000)
+
+    def test_actual_rows_hits_ghost_readmission_and_reuse_in_both_io_modes(self):
+        with tempfile.TemporaryDirectory() as directory:
+            fixture = fixtures.Fixture(directory)
+            self.addCleanup(fixture.store.close)
+            fixture.build()
+            for sidecar in ('', str(fixture.out)):
+                with self.subTest(sidecar=bool(sidecar)), mock.patch.dict(os.environ, {
+                        POLICY_FLAG: 's3fifo', fixtures.SIDE_FLAG: sidecar}):
+                    pool = expert_pool.ExpertPool(fixture.store, 4096 + 16 * 3072000)
+                    self.addCleanup(pool.close)
+                    self.assertIs(pool._slot_of, pool._policy.slot_of)
+                    self.assertIs(pool._free, pool._policy.free)
+                    old, _ = pool.assign(4, [0, 1, 2])
+                    pool.assign(9, list(range(13)))
+                    with ThreadPoolExecutor(8) as workers:
+                        for expert in (4, 0, 3, 2, 4, 0):
+                            assigned, misses = pool.assign(4, [1, expert])
+                            for future in pool.fill(fixtures.PREFIX, misses, workers.submit):
+                                future.result()
+                            # Fill any initially retained row too, since it was only assigned above.
+                            if expert == 4:
+                                for future in pool.fill(fixtures.PREFIX, [(1, assigned[1])], workers.submit):
+                                    future.result()
+                            self.assertEqual(assigned[1], old[1])
+                            for e, slot in assigned.items():
+                                for projection in ('gate_proj', 'up_proj', 'down_proj'):
+                                    for part in ('weight', 'scales', 'biases'):
+                                        row = fixture.expected[fixtures.PREFIX + '.' + projection + '.' + part, e]
+                                        begin = 4096 + slot * 3072000 + pool.offsets[projection, part]
+                                        self.assertEqual(bytes(pool.array[begin:begin + len(row)]), row)
+                            state = pool.policy_diagnostics()
+                            self.assertEqual(state['small_count'] + state['main_count'], len(pool._slot_of))
+                            self.assertLessEqual(state['ghost_count'], 15)
+                            self.assertEqual((state['small_target'], state['main_target']), (1, 15))
+
+    def test_actual_short_checkpoint_read_drains_then_removes_new_queue_and_ghost_keys(self):
