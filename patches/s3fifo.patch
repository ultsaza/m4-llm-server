index 0000000..8aad21e
--- /dev/null
+++ b/models/flashnext/tests/unit/test_expert_pool_policy.py
@@ -0,0 +1,122 @@
+"""Standalone real cache-policy tests; no MLX import or pool bypass."""
+import unittest
+from models.flashnext import expert_pool_policy as policy
+
+
+class PolicyTests(unittest.TestCase):
+    def make(self, capacity=4, name='slru'):
+        self.assertTrue(hasattr(policy, 'ExpertPoolPolicy'), 'bounded policy is missing')
+        return policy.ExpertPoolPolicy(capacity, name)
+
+    def consistent(self, p):
+        keys = set(p.slot_of)
+        self.assertEqual(len(set(p.slot_of.values())), len(keys))
+        self.assertEqual(set(p.slot_of.values()) | set(p.free), set(range(p.capacity)))
+        self.assertFalse(set(p.slot_of.values()) & set(p.free))
+        self.assertEqual(len(p.free), len(set(p.free)))
+        state = p.diagnostics()
+        self.assertLessEqual(state['protected_count'], int(p.protected_fraction * p.capacity))
+        self.assertEqual(state['probation_count'] + state['protected_count'], len(keys))
+
+    def test_promote_demote_and_probation_victim_order(self):
+        p = self.make()
+        first, _ = p.assign(1, [0, 1, 2, 3])
+        p.assign(1, [0, 1])
+        p.assign(1, [2])  # protected quota 2; 0 demotes to probation MRU
+        slots, misses = p.assign(1, [4])
+        self.assertEqual(misses, [(4, first[3])])
+        self.assertNotIn((1, 3), p.slot_of)
+        slots, misses = p.assign(1, [5])
+        self.assertEqual(misses, [(5, first[0])])
+        self.consistent(p)
+
+    def test_protects_mixed_hits_and_new_admissions_with_protected_fallback(self):
+        p = self.make(3)
+        first, _ = p.assign(1, [0, 1, 2])
+        p.assign(1, [0, 1])
+        slots, misses = p.assign(1, [2, 3, 4])
+        self.assertEqual(slots[2], first[2])
+        self.assertEqual(misses, [(3, first[0]), (4, first[1])])
+        self.assertEqual(set(p.slot_of), {(1, 2), (1, 3), (1, 4)})
+        self.consistent(p)
+
+    def test_capacity_one_protects_request_even_with_zero_protected_quota(self):
+        p = self.make(1)
+        p.assign(1, [0])
+        self.assertEqual(p.assign(1, [0]), ({0: 0}, []))
+        self.assertEqual(p.assign(1, [1]), ({1: 0}, [(1, 0)]))
+        self.consistent(p)
+
+    def test_oversize_rejected_before_any_hit_promotion_or_mutation(self):
+        p = self.make(2)
+        p.assign(1, [0, 1])
+        before = (list(p.slot_of.items()), list(p.free), p.diagnostics())
+        with self.assertRaisesRegex(ValueError, 'capacity'):
+            p.assign(1, [0, 1, 2])
+        self.assertEqual((list(p.slot_of.items()), list(p.free), p.diagnostics()), before)
+        self.assertEqual(p.assign(1, [0, 0]), ({0: 0}, []))
+
+    def test_invalidation_keeps_hits_without_restoring_evictions_and_frees_once(self):
+        p = self.make(3)
+        first, _ = p.assign(1, [0, 1, 2])
+        retained, misses = p.assign(1, [0, 3, 4])
+        p.assign(1, [3])  # invalidate must also remove a promoted incomplete entry
+        p.invalidate(1, misses)
+        p.invalidate(1, misses)
+        self.assertEqual(dict(p.slot_of), {(1, 0): first[0]})
+        self.assertEqual(retained[0], first[0])
+        self.consistent(p)
+        _, next_misses = p.assign(2, [0, 1])
+        self.assertEqual({slot for _, slot in next_misses}, {first[1], first[2]})
+        self.consistent(p)
+
+    def test_repeated_eviction_and_reuse_stays_bounded(self):
+        p = self.make(5)
+        for layer in range(200):
+            assigned, misses = p.assign(layer, [0, 1, 2, 3])
+            p.assign(layer, [1, 3])
+            self.assertEqual(len(set(assigned.values())), 4)
+            self.consistent(p)
+            self.assertLessEqual(len(p.diagnostics()['probation_oldest']), 8)
+
+    def test_lru_preserves_oldest_hit_first_admission(self):
+        p = self.make(name='lru')
+        first, _ = p.assign(1, [0, 1, 2, 3])
+        assigned, misses = p.assign(1, [0, 4, 5])
+        self.assertEqual(assigned[0], first[0])
+        self.assertEqual(misses, [(4, first[1]), (5, first[2])])
+
+    def test_fraction_is_finite_and_strictly_inside_unit_interval(self):
+        for value in (0, 1, -0.1, 1.1, float('nan'), float('inf'),
+                      float('-inf'), 'bad', '', None, True):
+            with self.subTest(value=value), self.assertRaises(ValueError):
+                policy.ExpertPoolPolicy(10, 'slru', protected_fraction=value)
+        with self.assertRaises(ValueError):
+            policy.ExpertPoolPolicy(10, 'lru', protected_fraction=0.5)
+
+    def test_half_fraction_exact_quota_demotions_and_victim_identity(self):
+        p = policy.ExpertPoolPolicy(5, 'slru', protected_fraction='0.5')
+        first, _ = p.assign(1, [0, 1, 2, 3, 4])
+        p.assign(1, [0, 1, 2])
+        self.assertEqual(p.protected_capacity, 2)
+        self.assertEqual(p.diagnostics()['protected_fraction'], 0.5)
+        self.assertEqual(p.diagnostics()['protected_oldest'], [(1, 1), (1, 2)])
+        self.assertEqual(p.diagnostics()['probation_oldest'], [(1, 3), (1, 4), (1, 0)])
+        self.assertEqual(p.assign(1, [3, 5, 6])[1], [(5, first[4]), (6, first[0])])
+        self.assertEqual(p.diagnostics()['protected_oldest'], [(1, 2), (1, 3)])
+        self.consistent(p)
+
+    def test_default_fraction_and_lru_behavior_remain_unchanged(self):
+        for name in ('lru', 'slru'):
+            p = policy.ExpertPoolPolicy(10, name)
+            self.assertEqual(p.protected_fraction, 0.7)
+            self.assertEqual(p.protected_capacity, 7)
+
+    def test_rejects_unknown_policy(self):
+        self.assertTrue(hasattr(policy, 'ExpertPoolPolicy'), 'bounded policy is missing')
+        with self.assertRaisesRegex(ValueError, 'policy'):
+            policy.ExpertPoolPolicy(4, 'typo')
+
+
+if __name__ == '__main__':
+    unittest.main()
