+    def run_pool_failure(self, warm_failure=False, submit_failure=False):
+        old, _ = self.pool.assign(4, [3])
+        started, release, queued_done = threading.Event(), threading.Event(), threading.Event()
+        observed, errors = [], []
+        def read(*_):
+            started.set()
+            if not release.wait(2):
+                raise AssertionError("test release timed out")
+            if not warm_failure:
+                raise OSError("short read")
+        def queued(*_):
+            queued_done.set()
+        # Call the real _pool_pass transaction, fail before Metal execution.
+        owner = SimpleNamespace(layer_id=4, hits=0, misses=0,
+                                gate_proj=SimpleNamespace(group_size=32, cache=SimpleNamespace(
+                                    store=self.pool.store, prefix=PREFIX + ".gate_proj")))
+        with ThreadPoolExecutor(1) as workers:
+            count = [0]
+            def submit(fn, *args):
+                count[0] += 1
+                if submit_failure and count[0] == 3:
+                    raise RuntimeError("submit failed")
+                return workers.submit(read if count[0] == 1 else queued)
+            def warm(_):
+                self.assertTrue(started.wait(1))
+                raise RuntimeError("warm failed")
+            def execute():
+                try:
+                    expert_cache.StreamingSwitchGLU._pool_pass(
+                        owner, None, [3, 0, 1], None, None, None, None, None)
+                except BaseException as error:
+                    errors.append(error)
+            native = self.pool.invalidate
+            def invalidate(layer, misses):
+                observed.append((release.is_set(), queued_done.is_set()))
+                native(layer, misses)
+            with mock.patch.object(expert_pool, "for_store", return_value=self.pool), \
+                    mock.patch.object(expert_cache, "_submit_read", side_effect=submit), \
