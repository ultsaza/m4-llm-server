+"""Bounded slot ownership with opt-in SLRU and batch-protected S3-FIFO."""
+from collections import OrderedDict
+from itertools import islice
+import math
+
+POLICY_FLAG = 'FLASHNEXT_EXPERT_POOL_CACHE_POLICY'
+FRACTION_FLAG = 'FLASHNEXT_EXPERT_POOL_SLRU_PROTECTED_FRACTION'
+
+
+def canonical_policy(value):
+    name = value or 'lru'
+    if name not in ('lru', 'slru', 's3fifo'):
+        raise ValueError(f'{POLICY_FLAG}: unknown cache policy {name!r}')
+    return name
+
+
+def canonical_protected_fraction(value):
+    try:
+        fraction = float(value) if not isinstance(value, bool) else float('nan')
+    except (TypeError, ValueError, OverflowError) as error:
+        raise ValueError(f'{FRACTION_FLAG} must be finite and strictly between 0 and 1') from error
+    if not math.isfinite(fraction) or not 0 < fraction < 1:
+        raise ValueError(f'{FRACTION_FLAG} must be finite and strictly between 0 and 1')
+    return fraction
+
+
+class ExpertPoolPolicy:
+    def __init__(self, capacity, policy='lru', protected_fraction=0.7):
+        self.policy = canonical_policy(policy)
+        self.protected_fraction = canonical_protected_fraction(protected_fraction)
+        if self.policy != 'slru' and self.protected_fraction != 0.7:
+            raise ValueError(f'{FRACTION_FLAG} requires SLRU')
+        if capacity < 1:
+            raise ValueError('expert pool capacity must be positive')
+        self.capacity = capacity
+        self.protected_capacity = int(self.protected_fraction * capacity)
+        self.slot_of = OrderedDict()
+        self.free = list(range(capacity - 1, -1, -1))
+        # Metadata only: resident queues share the same slot/free ownership.
+        self._probation = OrderedDict()
+        self._protected = OrderedDict()
+        self.small_target = max(1, int(0.1 * capacity))
+        self.main_target = capacity - self.small_target
+        self._small = OrderedDict()
+        self._main = OrderedDict()
+        self._ghost = OrderedDict()
+        self._frequency = {}
+
+    def _hit(self, key):
+        if self.policy == 's3fifo':
+            self._frequency[key] = min(3, self._frequency[key] + 1)
+            return
+        self.slot_of.move_to_end(key)
+        if self.policy == 'lru':
+            return
+        if key in self._protected:
+            self._protected.move_to_end(key)
+        else:
+            del self._probation[key]
+            self._protected[key] = None
+            if len(self._protected) > self.protected_capacity:
+                demoted, _ = self._protected.popitem(last=False)
+                self._probation[demoted] = None
+
+    @staticmethod
+    def _eligible(queue, requested):
+        return next((key for key in queue if key not in requested), None)
+
+    def _evict_main(self, requested):
+        # A frequency is at most three: eligible rotations always terminate.
+        while True:
+            key = self._eligible(self._main, requested)
+            if key is None:
+                return None
+            if self._frequency[key]:
+                self._frequency[key] -= 1
+                self._main.move_to_end(key)
+            else:
+                del self._main[key]
+                del self._frequency[key]
+                return self.slot_of.pop(key)
+
+    def _evict_small(self, requested):
+        while True:
+            key = self._eligible(self._small, requested)
+            if key is None:
+                return None
+            del self._small[key]
+            if self._frequency[key] >= 2:
+                self._main[key] = None
+                self._frequency[key] = 0
