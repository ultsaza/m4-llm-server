+import unittest
+from models.flashnext.tests.bench import replay_pool_policy as replay
+
+
+class ReplayTests(unittest.TestCase):
+    def test_replays_real_policy_and_rejects_wrong_lru_trace(self):
+        self.assertTrue(hasattr(replay, 'replay'), 'production-policy replay is missing')
+        routes = [
+            {'layer': 1, 'experts': [0, 1, 2], 'misses': [[0, 0], [1, 1], [2, 2]]},
+            {'layer': 1, 'experts': [0, 3], 'misses': [[3, 1]]},
+            {'layer': 1, 'experts': [2, 4], 'misses': [[4, 0]]},
+        ]
+        self.assertEqual(replay.replay(routes, 3, [], 'lru', verify=True)['misses'], 5)
+        self.assertEqual(replay.replay(routes, 3, [], 'slru')['misses'], 5)
+        routes[-1]['misses'] = []
+        with self.assertRaisesRegex(ValueError, 'batch 2'):
+            replay.replay(routes, 3, [], 'lru', verify=True)
+
+    def test_initial_slot_mapping_and_free_order_are_preserved(self):
+        self.assertTrue(hasattr(replay, 'replay'), 'production-policy replay is missing')
+        routes = [{'layer': 1, 'experts': [8, 9], 'misses': [[9, 0]]}]
+        actual = replay.replay(routes, 3, [[1, 8, 2]], 'lru', verify=True, free=[1, 0])
+        self.assertEqual(actual['misses'], 1)
+
+    def test_replay_selects_half_fraction_on_production_class(self):
+        routes = [{'layer': 1, 'experts': [0, 1, 2, 3, 4]},
+                  {'layer': 1, 'experts': [0, 1, 2]}]
+        half = replay.replay(routes, 5, [], 'slru', protected_fraction=0.5)
+        self.assertEqual(half['final_diagnostics']['protected_capacity'], 2)
+        self.assertEqual(half['final_diagnostics']['protected_fraction'], 0.5)
+        self.assertEqual(replay.replay(routes, 5, [], 'slru')['final_diagnostics']['protected_capacity'], 3)
