+"""S3-FIFO behavior through the stdlib production policy."""
+import copy
+import random
+import unittest
+from models.flashnext.expert_pool_policy import ExpertPoolPolicy
+
+
+class S3FIFOTests(unittest.TestCase):
+    def make(self, capacity=4):
+        return ExpertPoolPolicy(capacity, 's3fifo')
+
+    def consistent(self, p):
+        state = p.diagnostics()
+        self.assertEqual(set(p._small) | set(p._main), set(p.slot_of))
+        self.assertFalse(set(p._small) & set(p._main))
+        self.assertEqual(set(p._frequency), set(p.slot_of))
+        self.assertTrue(all(type(f) is int and 0 <= f <= 3 for f in p._frequency.values()))
+        self.assertLessEqual(len(p._ghost), p.main_target)
+        self.assertEqual(set(p.slot_of.values()) | set(p.free), set(range(p.capacity)))
+        self.assertFalse(set(p.slot_of.values()) & set(p.free))
+        self.assertEqual(len(set(p.slot_of.values())), len(p.slot_of))
+        self.assertEqual(len(set(p.free)), len(p.free))
+        self.assertEqual(state['small_count'] + state['main_count'], len(p.slot_of))
+        for name in ('small', 'main', 'ghost'):
+            self.assertLessEqual(len(state[name + '_oldest']), 8)
+
+    def test_hits_cap_frequency_without_reordering_fifo(self):
+        p = self.make()
+        p.assign(1, [0, 1, 2, 3])
+        for _ in range(8):
+            p.assign(1, [1, 0])
+        self.assertEqual(p.diagnostics()['small_oldest'], [(1, i) for i in range(4)])
+        self.assertEqual([p._frequency[1, i] for i in range(4)], [3, 3, 0, 0])
+        self.consistent(p)
+
+    def test_two_hits_promote_reset_then_evict_next_cold_small(self):
+        p = self.make()
+        first, _ = p.assign(1, [0, 1, 2, 3])
+        p.assign(1, [0]); p.assign(1, [0])
+        self.assertEqual(p.assign(1, [4])[1], [(4, first[1])])
+        self.assertEqual(p.diagnostics()['main_oldest'], [(1, 0)])
+        self.assertEqual(p._frequency[1, 0], 0)
+        self.assertEqual(p.diagnostics()['ghost_oldest'], [(1, 1)])
+        self.consistent(p)
+
+    def test_ghost_admission_retains_membership_and_main_aging_victim_order(self):
+        p = self.make()
+        first, _ = p.assign(1, [0, 1, 2, 3])
+        p.assign(1, [4])  # 0 becomes a ghost
+        p.assign(1, [0])  # ghost 0 enters main, replacing cold small 1
+        self.assertIn((1, 0), p._ghost)
+        self.assertEqual(list(p._main), [(1, 0)])
+        p.assign(1, [1]); p.assign(1, [2]); p.assign(1, [3])
+        # main now has 0,1,2,3, small has no entries; age 0 twice.
+        p.assign(1, [0]); p.assign(1, [0])
+        slot1 = p.slot_of[1, 1]
+        self.assertEqual(p.assign(1, [5])[1], [(5, slot1)])
+        self.assertEqual(list(p._main), [(1, 2), (1, 3), (1, 0)])
+        self.assertEqual(p._frequency[1, 0], 1)
+        self.assertNotIn((1, 1), p._main)
+        self.consistent(p)
+
+    def test_all_small_protected_falls_back_to_main_and_keeps_new_misses(self):
+        p = self.make()
+        p.assign(1, [0, 1, 2, 3]); p.assign(1, [4]); p.assign(1, [0])
+        # main 0; small 2,3,4. All small keys protected, so main is victim.
+        old = dict(p.slot_of)
+        assigned, misses = p.assign(1, [2, 3, 4, 5])
+        self.assertEqual(misses, [(5, old[1, 0])])
+        self.assertEqual({(1, e) for e in assigned}, set(p.slot_of))
+        self.consistent(p)
+
+    def test_protected_main_promotion_falls_back_and_terminates(self):
+        p = self.make(2)
+        p.assign(1, [0, 1]); p.assign(1, [0]); p.assign(1, [0])
+        p.assign(1, [2])  # promote 0 and remove 1
+        assigned, misses = p.assign(1, [0, 3])
+        self.assertEqual(assigned[0], 0)
+        self.assertEqual(misses, [(3, 1)])
+        self.consistent(p)
+
+    def test_capacities_one_two_and_repeated_mixed_batches_terminate(self):
+        rng = random.Random(941)
+        for capacity in (1, 2, 3, 16, 37):
+            p = self.make(capacity)
+            for _ in range(600):
+                requested = rng.sample(range(capacity * 3), rng.randint(1, capacity))
+                assigned, misses = p.assign(1, requested)
+                self.assertEqual(list(assigned), [e for e in requested if (1, e) not in {(1, m) for m, _ in misses}] + [e for e, _ in misses])
+                self.assertTrue({(1, e) for e in requested} <= set(p.slot_of))
+                self.consistent(p)
+            self.assertEqual(p.small_target, max(1, int(0.1 * capacity)))
+            self.assertEqual(p.main_target, capacity - p.small_target)
+
+    def test_oversized_request_is_atomic_including_frequency_and_ghost(self):
+        p = self.make(2)
+        p.assign(1, [0, 1]); p.assign(1, [2])
+        before = copy.deepcopy(p.__dict__)
+        with self.assertRaisesRegex(ValueError, 'capacity'):
+            p.assign(1, [1, 2, 3])
+        self.assertEqual(p.__dict__, before)
+
+    def test_invalidation_removes_incomplete_ghost_main_and_returns_slots_once(self):
+        p = self.make()
+        original, _ = p.assign(1, [0, 1, 2, 3])
+        p.assign(1, [4])
+        assigned, misses = p.assign(1, [2, 0, 5])
+        self.assertIn((1, 0), p._ghost)
+        p.assign(1, [0]); p.assign(1, [0])
+        p.invalidate(1, misses); p.invalidate(1, misses)
+        self.assertNotIn((1, 0), p._ghost)
+        self.assertNotIn((1, 0), p._frequency)
+        self.assertNotIn((1, 5), p.slot_of)
+        self.assertEqual(p.slot_of[1, 2], original[2])
+        self.assertEqual(assigned[2], original[2])
+        self.assertNotIn((1, 1), p.slot_of)
+        self.consistent(p)
+
+    def test_nondefault_slru_fraction_is_rejected(self):
+        with self.assertRaisesRegex(ValueError, 'SLRU'):
+            ExpertPoolPolicy(16, 's3fifo', protected_fraction=0.5)
+
+
+if __name__ == '__main__':
+    unittest.main()
