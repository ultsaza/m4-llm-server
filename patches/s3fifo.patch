+                    slot = self._evict_main(requested)
+                    if slot is not None:
+                        return slot
+            else:
+                self._ghost[key] = None
+                self._ghost.move_to_end(key)
+                if len(self._ghost) > self.main_target:
+                    self._ghost.popitem(last=False)
+                del self._frequency[key]
+                return self.slot_of.pop(key)
+
+    def _victim(self, requested):
+        if self.policy == 's3fifo':
+            evictors = ((self._evict_small, self._evict_main)
+                        if len(self._small) >= self.small_target else
+                        (self._evict_main, self._evict_small))
+            for evict in evictors:
+                slot = evict(requested)
+                if slot is not None:
+                    return slot
+            raise RuntimeError('expert pool has no eligible victim')
+        if self.policy == 'lru':
+            return self.slot_of.popitem(last=False)[1]
+        for queue in (self._probation, self._protected):
+            for key in queue:
+                if key not in requested:
+                    del queue[key]
+                    return self.slot_of.pop(key)
+        raise RuntimeError('expert pool has no eligible victim')
+
+    def assign(self, layer, experts):
+        experts = list(dict.fromkeys(experts))
+        if len(experts) > self.capacity:
+            raise ValueError('expert request exceeds pool capacity')
+        requested = {(layer, expert) for expert in experts}
+        assigned, misses = {}, []
+        for expert in experts:
+            key = (layer, expert)
+            slot = self.slot_of.get(key)
+            if slot is not None:
+                self._hit(key)
+                assigned[expert] = slot
+        for expert in experts:
+            if expert in assigned:
+                continue
+            slot = self.free.pop() if self.free else self._victim(requested)
+            key = (layer, expert)
+            self.slot_of[key] = slot
+            if self.policy == 'slru':
+                self._probation[key] = None
+            elif self.policy == 's3fifo':
+                (self._main if key in self._ghost else self._small)[key] = None
+                self._frequency[key] = 0
+            assigned[expert] = slot
+            misses.append((expert, slot))
+        return assigned, misses
+
+    def invalidate(self, layer, misses):
+        free = set(self.free)
+        for expert, slot in misses:
+            key = (layer, expert)
+            if self.slot_of.get(key) == slot:
+                del self.slot_of[key]
+                self._probation.pop(key, None)
+                self._protected.pop(key, None)
+                self._small.pop(key, None)
+                self._main.pop(key, None)
+                self._frequency.pop(key, None)
+                self._ghost.pop(key, None)
+                if slot not in free:
+                    self.free.append(slot)
+                    free.add(slot)
+
+    def diagnostics(self):
+        probation = self._probation if self.policy == 'slru' else self.slot_of
+        state = {'policy': self.policy, 'protected_fraction': self.protected_fraction,
+                'protected_capacity': self.protected_capacity,
+                'probation_count': len(probation), 'protected_count': len(self._protected),
+                'probation_oldest': list(islice(probation, 8)),
+                'protected_oldest': list(islice(self._protected, 8))}
+        if self.policy == 's3fifo':
+            state.update(small_target=self.small_target, main_target=self.main_target,
+                         small_count=len(self._small), main_count=len(self._main),
+                         ghost_count=len(self._ghost), maximum_frequency=3,
+                         promotion_threshold=2,
+                         small_oldest=list(islice(self._small, 8)),
+                         main_oldest=list(islice(self._main, 8)),
+                         ghost_oldest=list(islice(self._ghost, 8)))
+        return state
