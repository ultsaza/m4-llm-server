diff --git a/models/flashnext/tests/bench/replay_pool_policy.py b/models/flashnext/tests/bench/replay_pool_policy.py
new file mode 100644
index 0000000..fbb36ed
--- /dev/null
+++ b/models/flashnext/tests/bench/replay_pool_policy.py
@@ -0,0 +1,72 @@
+"""Offline validated-route replay through the production slot policy, not inference."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from models.flashnext.expert_pool_policy import ExpertPoolPolicy, canonical_protected_fraction
+
+
+def replay(routes, capacity, initial, name, verify=False, free=None, protected_fraction=0.7):
+    policy = ExpertPoolPolicy(capacity, name, protected_fraction=protected_fraction)
+    if initial:
+        # Coverage records exact LRU ordering and ownership at prefill boundary.
+        for layer, expert, slot in initial:
+            policy.slot_of[layer, expert] = slot
+            if name == 'slru':
+                policy._probation[layer, expert] = None
+        occupied = set(policy.slot_of.values())
+        policy.free[:] = free if free is not None else [s for s in policy.free if s not in occupied]
+    total, per_token = 0, []
+    for index, route in enumerate(routes):
+        _, misses = policy.assign(route['layer'], route['experts'])
+        if verify and [list(pair) for pair in misses] != route['misses']:
+            raise ValueError(f'actual LRU slots/misses differ at route batch {index}')
+        total += len(misses)
+        if index % 47 == 0:
+            per_token.append(0)
+        per_token[-1] += len(misses)
+    return {'misses': total, 'requested_bytes': total * 3072000, 'misses_per_token': per_token,
+            'final_diagnostics': policy.diagnostics()}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('input', type=Path)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--slru-protected-fraction', type=canonical_protected_fraction, default=0.7)
+    args = parser.parse_args()
+    raw = args.input.read_bytes()
+    row = json.loads(raw)
+    if not row.get('validated') or row.get('runtime_cache_policy', 'lru') != 'lru':
+        raise ValueError('replay requires validated LRU coverage')
+    boundary = row['coverage']['boundary']
+    routes = row['coverage']['routes']
+    capacity = (row['effective_pool_bytes'] - 4096) // 3072000
+    initial = boundary['initial_slot_of']
+    if not routes or len(routes) != 47 * row['gen_tokens'] or any(
+            route['layer'] != index % 47 + 1 for index, route in enumerate(routes)):
+        raise ValueError('route trace does not cover actual 47-layer decode work')
+    if boundary['pool_created'] and capacity != boundary['initial_pool_capacity']:
+        raise ValueError('trace pool geometry mismatch')
+    if initial:
+        # No SLRU queue history can be recovered from an old LRU boundary.
+        raise ValueError('SLRU screening requires the validated empty prefill pool boundary')
+    lru = replay(routes, capacity, initial, 'lru', verify=True)
+    if lru['misses'] != row['pool_misses'] - boundary['misses']:
+        raise ValueError('LRU replay differs from actual decode miss counter')
+    slru = replay(routes, capacity, initial, 'slru', protected_fraction=args.slru_protected_fraction)
+    result = {'input': str(args.input), 'input_sha256': hashlib.sha256(raw).hexdigest(),
+              'production_policy_sha256': hashlib.sha256(Path(__import__(
+                  ExpertPoolPolicy.__module__, fromlist=['']).__file__).read_bytes()).hexdigest(),
+              'slru_protected_fraction': args.slru_protected_fraction,
+              'capacity': capacity, 'initial_entries': len(initial), 'route_batches': len(routes),
+              'actual_lru_matches_every_batch_and_slot': True, 'policies': {'lru': lru, 'slru': slru},
+              'miss_reduction_percent': (1 - slru['misses'] / lru['misses']) * 100,
+              'limitation': 'Offline miss counts on one validated route trace; no inference speed, quality, or deployment claim'}
+    args.output.write_text(json.dumps(result, indent=2) + '\n')
+    print(json.dumps({k: v for k, v in result.items() if k != 'policies'}))
+    print(json.dumps({name: value['misses'] for name, value in result['policies'].items()}))
+
+
+if __name__ == '__main__':
+    main()
