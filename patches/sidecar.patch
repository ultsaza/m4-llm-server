+class _InterruptedWait:
+    """Interrupt one wait; completion always belongs to the real Future."""
+    def __init__(self, future, interrupted):
+        self.future = future
+        self.interrupted = interrupted
+        self.once = True
+
+    def result(self):
+        if self.once:
+            self.once = False
+            self.interrupted.set()
+            raise KeyboardInterrupt("interrupted result wait")
+        return self.future.result()
+
+    def done(self):
+        return self.future.done()
+
+
+class TransactionTests(unittest.TestCase):
+    def setUp(self):
+        with mock.patch.dict(os.environ, {SIDE_FLAG: ""}):
+            self.pool = expert_pool.ExpertPool(SimpleNamespace(dir="/absent", refs={}),
+                                              4096 + 16 * 3072000)
+        self.addCleanup(self.pool.close)
+
+    def test_invalidation_retains_old_hits_and_does_not_restore_evicted_mapping(self):
+        old, _ = self.pool.assign(4, list(range(16)))
+        slots, misses = self.pool.assign(4, [7, 20, 21])
+        self.assertEqual({slot for _, slot in misses}, {old[0], old[1]})
+        self.pool.invalidate(4, misses)
+        self.pool.invalidate(4, misses)
+        self.assertEqual(len(self.pool._free), 2)
+        self.assertEqual(len(set(self.pool._free)), 2)
+        again, new = self.pool.assign(4, [7, 0, 20])
+        self.assertEqual(again[7], old[7])
+        self.assertEqual({expert for expert, _ in new}, {0, 20})
+        self.assertEqual(len(set(self.pool._slot_of.values())), len(self.pool._slot_of))
+
