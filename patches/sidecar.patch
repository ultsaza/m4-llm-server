+    def test_partial_submit_failure_drains_running_and_queued_reads(self):
+        started, release, queued_done = threading.Event(), threading.Event(), threading.Event()
+        def blocking(*_):
+            started.set()
+            if not release.wait(2):
+                raise AssertionError("test worker release timed out")
+        def queued(*_):
+            queued_done.set()
+        errors = []
+        with ThreadPoolExecutor(1) as workers:
+            count = [0]
+            def submit(fn, *args):
+                count[0] += 1
+                if count[0] == 3:
+                    raise RuntimeError("submit failed")
+                return workers.submit(blocking if count[0] == 1 else queued)
+            def fill():
+                try:
+                    self.pool.fill(PREFIX, [(0, 0)], submit)
+                except BaseException as error:
+                    errors.append(error)
+            thread = threading.Thread(target=fill)
+            thread.start()
+            self.assertTrue(started.wait(1))
+            thread.join(0.02)
+            still_draining = thread.is_alive()
+            release.set()
+            thread.join(2)
+        self.assertTrue(still_draining, "submit exception escaped before running read drained")
+        self.assertTrue(queued_done.is_set(), "queued task was not drained")
+        self.assertEqual(str(errors[0]), "submit failed")
+
+    def run_pool_failure(self, warm_failure=False, submit_failure=False):
+        old, _ = self.pool.assign(4, [3])
+        started, release, queued_done = threading.Event(), threading.Event(), threading.Event()
+        observed, errors = [], []
+        def read(*_):
+            started.set()
+            if not release.wait(2):
+                raise AssertionError("test release timed out")
+            if not warm_failure:
+                raise OSError("short read")
+        def queued(*_):
+            queued_done.set()
+        # Call the real _pool_pass transaction, fail before Metal execution.
+        owner = SimpleNamespace(layer_id=4, hits=0, misses=0,
+                                gate_proj=SimpleNamespace(group_size=32, cache=SimpleNamespace(
+                                    store=self.pool.store, prefix=PREFIX + ".gate_proj")))
+        with ThreadPoolExecutor(1) as workers:
+            count = [0]
+            def submit(fn, *args):
+                count[0] += 1
+                if submit_failure and count[0] == 3:
+                    raise RuntimeError("submit failed")
+                return workers.submit(read if count[0] == 1 else queued)
+            def warm(_):
+                self.assertTrue(started.wait(1))
+                raise RuntimeError("warm failed")
+            def execute():
+                try:
+                    expert_cache.StreamingSwitchGLU._pool_pass(
+                        owner, None, [3, 0, 1], None, None, None, None, None)
+                except BaseException as error:
+                    errors.append(error)
+            native = self.pool.invalidate
+            def invalidate(layer, misses):
+                observed.append((release.is_set(), queued_done.is_set()))
+                native(layer, misses)
+            with mock.patch.object(expert_pool, "for_store", return_value=self.pool), \
+                    mock.patch.object(expert_cache, "_submit_read", side_effect=submit), \
+                    mock.patch.object(expert_cache, "_KEEPWARM", [warm_failure]), \
+                    mock.patch.object(expert_cache, "_keep_gpu_warm_until", side_effect=warm), \
+                    mock.patch.object(self.pool, "invalidate", side_effect=invalidate):
+                thread = threading.Thread(target=execute)
+                thread.start()
+                self.assertTrue(started.wait(1))
+                thread.join(0.02)
+                still_draining = thread.is_alive()
+                release.set()
+                thread.join(2)
+        self.assertTrue(still_draining)
+        self.assertFalse(thread.is_alive())
+        self.assertEqual(observed, [(True, True)])
+        self.assertTrue(errors)
+        self.assertEqual(self.pool._slot_of.get((4, 3)), old[3])
+        self.assertNotIn((4, 0), self.pool._slot_of)
+        self.assertNotIn((4, 1), self.pool._slot_of)
+        self.assertEqual(len(self.pool._free), 15)
+        self.assertEqual(len(set(self.pool._free)), 15)
