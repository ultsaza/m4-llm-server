+    def run_interrupted_failure_drain(self, submit_failure):
+        old, _ = self.pool.assign(4, [3])
+        started, release, interrupted = threading.Event(), threading.Event(), threading.Event()
+        finished, write_done = threading.Event(), threading.Event()
+        futures, errors, invalidations = [], [], []
+        owner = SimpleNamespace(layer_id=4, hits=0, misses=0,
+                                gate_proj=SimpleNamespace(group_size=32, cache=SimpleNamespace(
+                                    store=self.pool.store, prefix=PREFIX + ".gate_proj")))
+        primary = RuntimeError("submit failed" if submit_failure else "warm failed")
+        # These are actual background writes into the actual pool buffer.
+        # Only waiting is adapted: every completion/done state is a real Future.
+        def write(first):
+            if first:
+                started.set()
+                if not release.wait(2):
+                    raise AssertionError("test writer release timed out")
+                self.pool._view[4096 + 3072000] = 0x6A
+                write_done.set()
+                raise KeyboardInterrupt("completed worker error")
+        with ThreadPoolExecutor(1) as workers:
+            count = [0]
+            def submit(function, *args):
+                count[0] += 1
+                if submit_failure and count[0] == 2:
+                    raise primary
+                future = workers.submit(write, count[0] == 1)
+                futures.append(future)
+                return _InterruptedWait(future, interrupted)
+            def warm(_):
+                if not started.wait(1):
+                    raise AssertionError("test writer did not start")
+                raise primary
+            native = self.pool.invalidate
+            def invalidate(layer, misses):
